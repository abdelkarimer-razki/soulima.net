{
  "name": "soulima",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve:lan": "node streaming-server/server.js",
    "dev": "concurrently -n web,stream -c blue,magenta \"npm start\" \"npm run start --prefix streaming-server\"",
    "dev:lan": "concurrently -n web,stream -c blue,magenta \"ng serve --host 0.0.0.0 --disable-host-check\" \"HOST=0.0.0.0 npm run start --prefix streaming-server\"",
    "desktop:build": "node desktop/build.mjs",
    "desktop:start": "npm --prefix desktop start",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:install": "npm install && npm --prefix streaming-server install && npm --prefix desktop install && npm run desktop:build && npm --prefix desktop run package:deb && sudo apt install -y ./desktop/dist/*.deb",
    "desktop": "npm run desktop:build && npm run desktop:start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.0.0",
    "@angular/common": "^16.0.0",
    "@angular/compiler": "^16.0.0",
    "@angular/core": "^16.0.0",
    "@angular/forms": "^16.0.0",
    "@angular/platform-browser": "^16.0.0",
    "@angular/platform-browser-dynamic": "^16.0.0",
    "@angular/router": "^16.0.0",
    "@angular/youtube-player": "^16.2.5",
    "@vercel/analytics": "^1.3.1",
    "ngx-cookie-service": "^16.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.0.0",
    "@angular/cli": "~16.0.0",
    "@angular/compiler-cli": "^16.0.0",
    "@types/jasmine": "~4.3.0",
    "concurrently": "^10.0.4",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "puppeteer": "^25.17.0",
    "typescript": "~5.0.2"
  }
}
