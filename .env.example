# ==============================================================================
# Soulima — Environment Variables Configuration
# ==============================================================================

# Web & Streaming Server Port (default: 3030)
PORT=3030

# SubDL Subtitle API Key (free tier: https://subdl.com/panel/api)
# Enables multi-language subtitle search directly matched to TMDB IDs
SUBDL_API_KEY=

# The Movie Database (TMDB) API Key (optional - built-in key used if omitted)
TMDB_API_KEY=

# Daily offline download budget in Gigabytes (default: 15 GB)
DOWNLOAD_BUDGET_GB=15
